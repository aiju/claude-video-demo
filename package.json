{
  "name": "next-token",
  "private": true,
  "description": "A 60-second flashy WebGL + WebAudio animation of LLM internals, rendered live in the browser.",
  "type": "module",
  "scripts": {
    "start": "npx --yes http-server -c-1 -p 8080 .",
    "render": "node tools/render-video.mjs --w 1920 --h 1080 --fps 60 --out next-token.mp4",
    "render:preview": "node tools/render-video.mjs --w 1280 --h 720 --fps 30 --out next-token-720p.mp4",
    "frames": "node tools/frames.mjs frames 1280 720 2 10 18 28 33 40 49 55"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
